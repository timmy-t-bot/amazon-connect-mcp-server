{
  "Version": "2019-10-30",
  "StartAction": "SetVoice",
  "Actions": [
    {
      "Identifier": "SetVoice",
      "Type": "SetVoice",
      "Parameters": {
        "GlobalVoice": {
          "Language": "en-US",
          "Voice": "Joanna"
        }
      },
      "Transitions": {
        "NextAction": "PlayWelcome"
      }
    },
    {
      "Identifier": "PlayWelcome",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Thank you for calling. Please hold while we connect you to the next available agent.",
        "TextToSpeechType": "text"
      },
      "Transitions": {
        "NextAction": "TransferToQueue"
      }
    },
    {
      "Identifier": "TransferToQueue",
      "Type": "TransferToQueue",
      "Parameters": {
        "QueueId": "$.Attributes.QueueId",
        "ContactFlowId": "$.Attributes.ContactFlowId"
      },
      "Transitions": {
        "NextAction": "Disconnect"
      }
    },
    {
      "Identifier": "Disconnect",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
